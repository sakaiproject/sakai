<?xml version="1.0"?>
<faces-config xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_3_0.xsd"
              version="3.0">

  <application>
    <message-bundle>UserAuditMessages</message-bundle>
    <locale-config>
      <default-locale>en</default-locale>
    </locale-config>
  </application>
  
  <managed-bean>
    <managed-bean-name>eventLog</managed-bean-name>
    <managed-bean-class>org.sakaiproject.userauditservice.tool.UserAuditEventLog</managed-bean-class>
    <managed-bean-scope>session</managed-bean-scope>
    <managed-property>
      <property-name>userAuditService</property-name>
      <value>#{Components['org.sakaiproject.userauditservice.api.UserAuditService']}</value>
    </managed-property>
    <managed-property>
      <property-name>userDirectoryService</property-name>
      <value>#{Components['org.sakaiproject.user.api.UserDirectoryService']}</value>
    </managed-property>
    <managed-property>
      <property-name>userTimeService</property-name>
      <value>#{Components['org.sakaiproject.time.api.UserTimeService']}</value>
    </managed-property>
    <managed-property>
      <property-name>toolManager</property-name>
      <value>#{Components['org.sakaiproject.tool.api.ToolManager']}</value>
    </managed-property>
    <managed-property>
      <property-name>sessionManager</property-name>
      <value>#{Components['org.sakaiproject.tool.api.SessionManager']}</value>
    </managed-property>
  </managed-bean>
  
  <navigation-rule>
    <from-view-id>/eventLog.jsp</from-view-id>
  </navigation-rule>
</faces-config>
