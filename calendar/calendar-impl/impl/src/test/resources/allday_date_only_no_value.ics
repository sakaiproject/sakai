BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Sakai//IcalendarReaderTest//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Example Holiday Calendar
BEGIN:VEVENT
UID:date-only-past@example.com
DTSTAMP:20240101T120000Z
DTSTART:20190101
DTEND:20190102
SUMMARY:New Year Day
DESCRIPTION:Example date-only event without VALUE=DATE outside the timed import window
LOCATION:Example Location
END:VEVENT
BEGIN:VEVENT
UID:date-only-single@example.com
DTSTAMP:20240101T120000Z
DTSTART:20251225
DTEND:20251226
SUMMARY:Winter Holiday
DESCRIPTION:Example date-only event without VALUE=DATE
LOCATION:Example Location
END:VEVENT
BEGIN:VEVENT
UID:date-only-period@example.com
DTSTAMP:20240101T120000Z
DTSTART:20251223
DTEND:20260106
SUMMARY:Winter Break
DESCRIPTION:Example multi-day date-only event without VALUE=DATE
LOCATION:Example Location
END:VEVENT
END:VCALENDAR
