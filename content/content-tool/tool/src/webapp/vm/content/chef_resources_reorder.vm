## version: $Id:  $
<!-- chef_resources_reorder.vm, use with org.sakaiproject.tool.content.ResourcesAction.java -->
<!-- this is the reorder template -->

<div class="portletBody specialLink sakai-reorder">
	#contentMenu("resources")
	<form name="reorderForm" id="reorderForm" action="#toolForm("ResourcesAction")" method="post">
		<input name="folderId" id="folderId" value="$folderId" type="hidden" />
		<input name="sakai_action" id="sakai_action" value="doSaveOrder" type="hidden" />
		<input name="flow" id="flow" value="save" type="hidden" />

		<div class="page-header">
			<h1>$clang.getString("sort.title")</h1>
		</div>

		#if($collectionPath)
			<p class="sakai-reorder-breadcrumb">
				<span class="$contentTypeImageService.getContentTypeImageClass("folder")" aria-hidden="true"></span>
				<span class="visually-hidden">$clang.getString('gen.folder1')</span>
				#foreach ($item in $collectionPath)
					$formattedText.escapeHtml("$item.name")
					#if(! $item.isLast()) / #end
				#end
			</p>
		#end

		<div class="instruction">
			$clang.getString("sort.instruction.general")
			<span id="inputKbdMessage" class="visually-hidden">$clang.getString('sort.instruction.general.hidden')</span>
		</div>

		<div class="sakai-reorder-undo noPrint">
			<button type="button" class="btn btn-transparent btn-sm" id="undo-last" disabled>
				<span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span>
				$clang.getString("sort.undo.last.label")
			</button>
			<button type="button" class="btn btn-transparent btn-sm" id="undo-all" disabled>
				<span class="bi bi-arrow-repeat" aria-hidden="true"></span>
				$clang.getString("sort.undo.all.label")
			</button>
		</div>
		<span id="lastMoveArray" class="d-none"></span>
		<span id="lastMoveArrayInit" class="d-none"></span>
		<span id="lastItemMoved" class="visually-hidden" aria-live="polite" aria-atomic="true" data-moved-message="$clang.getString('sort.moved')"></span>

		<sakai-reorderer id="resources-reorderer" style="display:block" apply-dom>
		<ul id="reorder-list" class="list-group sakai-reorder-list">
			#foreach($root in $this_site)
				#set($collectionMembers = $root.members)
				#set($count = 1)
				#set($membersize = $collectionMembers.size())
				#foreach($member in $collectionMembers)
					<li class="list-group-item reorder-element sakai-reorder-row" id="listitem.orderable$count" data-reorderable-id="$formattedText.escapeHtml($member.id)">
						<div class="sakai-reorder-row-main">
							<div class="sakai-reorder-move-controls">
								<span class="btn btn-icon sakai-reorder-drag-handle drag-handle"
										tabindex="0"
										role="button"
										title="$clang.getString('sort.drag.handle')"
										aria-label="$clang.getString('sort.drag.handle')">
									<span class="si si-drag-handle" aria-hidden="true"></span>
								</span>
								<button type="button"
										class="btn btn-icon"
										data-action="move-up"
										#if ($count == 1) disabled="disabled" #end
										title="$clang.getString('sort.move.up')"
										aria-label="$clang.getString('sort.move.up')">
									<span class="bi bi-chevron-up" aria-hidden="true"></span>
								</button>
								<button type="button"
										class="btn btn-icon"
										data-action="move-down"
										#if ($count == $membersize) disabled="disabled" #end
										title="$clang.getString('sort.move.down')"
										aria-label="$clang.getString('sort.move.down')">
									<span class="bi bi-chevron-down" aria-hidden="true"></span>
								</button>
							</div>

							<div class="sakai-reorder-row-content">
								#if($member.isFolder())
									<span class="$contentTypeImageService.getContentTypeImageClass("folder")" aria-hidden="true"></span>
								#else
									<span class="$contentTypeImageService.getContentTypeImageClass("$member.type")" aria-hidden="true"></span>
								#end
								<div class="sakai-reorder-title-block">
									<div class="sakai-reorder-display">
										<span class="sakai-reorder-title" title="$formattedText.escapeHtml($member.name)">$formattedText.escapeHtml($member.name)</span>
									</div>
									<div class="sakai-reorder-meta">
										<span>$formattedText.escapeHtml($member.createdBy)</span>
										<span>$member.ModifiedTime</span>
									</div>
									<input type="hidden" name="position_$formattedText.escapeUrl("$member.id")" value="$count" class="resources-position"/>
								</div>
							</div>
						</div>
					</li>
					#set($count = $count + 1)
				#end
			#end
		</ul>
		</sakai-reorderer>

		<div class="act">
			<input id="save" value="$clang.getString("sort.save")" type="button" class="active btn btn-primary" onclick="submitThis('reorderForm','save');" />
			<input id="cancel" value="$clang.getString("sort.cancel")" type="button" class="btn btn-secondary" onclick="submitThis('reorderForm','cancel');" />
		</div>
		<input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
	</form>

</div>
<script type="text/javascript">
	function submitform(id)
	{
		var theForm = document.getElementById(id);
		if(theForm && theForm.onsubmit)
		{
			theForm.onsubmit();
		}
		if(theForm && theForm.submit)
		{
			theForm.submit();
		}
	}
	function submitThis(id, flow)
	{
		document.getElementById("flow").value = flow;
		submitform(id);
	}
</script>
#module("/webcomponents/bundles/sakai-reorderer.js")
#module("/sakai-content-tool/js/resources-reorder.js")
