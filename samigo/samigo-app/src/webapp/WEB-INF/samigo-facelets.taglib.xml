<?xml version="1.0" encoding="UTF-8"?>
<facelet-taglib xmlns="https://jakarta.ee/xml/ns/jakartaee" version="3.0">
  <namespace>http://www.sakaiproject.org/samigo</namespace>
  <tag>
    <tag-name>hideDivision</tag-name>
    <component>
      <component-type>jakarta.faces.Output</component-type>
      <renderer-type>HideDivision</renderer-type>
      <handler-class>org.sakaiproject.tool.assessment.ui.facelets.SamigoComponentHandler</handler-class>
    </component>
  </tag>
  <tag>
    <tag-name>timerBar</tag-name>
    <component>
      <component-type>jakarta.faces.Output</component-type>
      <renderer-type>TimerBar</renderer-type>
      <handler-class>org.sakaiproject.tool.assessment.ui.facelets.SamigoComponentHandler</handler-class>
    </component>
  </tag>
  <tag>
    <tag-name>dataLine</tag-name>
    <component>
      <component-type>jakarta.faces.Data</component-type>
      <renderer-type>DataLine</renderer-type>
      <handler-class>org.sakaiproject.tool.assessment.ui.facelets.SamigoComponentHandler</handler-class>
    </component>
  </tag>
  <tag>
    <tag-name>wysiwyg</tag-name>
    <component>
      <component-type>SakaiRichTextEditArea</component-type>
      <renderer-type>SakaiRichTextEditArea</renderer-type>
      <handler-class>org.sakaiproject.tool.assessment.ui.facelets.SamigoComponentHandler</handler-class>
    </component>
  </tag>
  <tag>
    <tag-name>radioButton</tag-name>
    <component>
      <component-type>CustomSelectOneRadio</component-type>
      <renderer-type>CustomSelectOneRadio</renderer-type>
      <handler-class>org.sakaiproject.tool.assessment.ui.facelets.SamigoComponentHandler</handler-class>
    </component>
  </tag>
  <tag>
    <tag-name>literal</tag-name>
    <component>
      <component-type>jakarta.faces.HtmlOutputText</component-type>
      <renderer-type>jakarta.faces.Text</renderer-type>
      <handler-class>org.sakaiproject.tool.assessment.ui.facelets.SamigoLiteralHandler</handler-class>
    </component>
  </tag>
  <tag>
    <tag-name>convertDateTime</tag-name>
    <converter>
      <converter-id>jakarta.faces.DateTime</converter-id>
      <handler-class>org.sakaiproject.tool.assessment.ui.facelets.SamigoDateTimeConverterHandler</handler-class>
    </converter>
  </tag>
</facelet-taglib>
