<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="org.sakaiproject.springframework.orm.hibernate.impl.AdditionalHibernateMappings.preferences"
          class="org.sakaiproject.springframework.orm.hibernate.impl.AdditionalHibernateMappingsImpl">
        <property name="annotatedClasses">
            <list>
                <value>org.sakaiproject.user.api.model.PreferencesRecord</value>
            </list>
        </property>
    </bean>

    <bean id="org.sakaiproject.user.api.repository.PreferencesRepository"
          class="org.sakaiproject.user.impl.repository.PreferencesRepositoryImpl">
        <property name="sessionFactory" ref="org.sakaiproject.springframework.orm.hibernate.GlobalSessionFactory"/>
    </bean>

    <bean id="org.sakaiproject.user.api.PreferencesService"
          class="org.sakaiproject.user.impl.BasePreferencesService"
          init-method="init"
          destroy-method="destroy">

        <property name="repository" ref="org.sakaiproject.user.api.repository.PreferencesRepository"/>
        <!-- Preference writes commit independently of any caller transaction. -->
        <property name="transactionTemplate">
            <bean class="org.springframework.transaction.support.TransactionTemplate">
                <property name="transactionManager" ref="org.sakaiproject.springframework.orm.hibernate.GlobalTransactionManager"/>
                <property name="propagationBehaviorName" value="PROPAGATION_REQUIRES_NEW"/>
            </bean>
        </property>
        <property name="readTransactionTemplate">
            <bean class="org.springframework.transaction.support.TransactionTemplate">
                <property name="transactionManager" ref="org.sakaiproject.springframework.orm.hibernate.GlobalTransactionManager"/>
                <property name="readOnly" value="true"/>
            </bean>
        </property>
        <property name="serverConfigurationService" ref="org.sakaiproject.component.api.ServerConfigurationService" />
        <property name="entityManager" ref="org.sakaiproject.entity.api.EntityManager" />
        <property name="securityService" ref="org.sakaiproject.authz.api.SecurityService" />
        <property name="functionManager" ref="org.sakaiproject.authz.api.FunctionManager" />
        <property name="sessionManager" ref="org.sakaiproject.tool.api.SessionManager" />
        <property name="eventTrackingService" ref="org.sakaiproject.event.api.EventTrackingService" />
        <property name="userDirectoryService" ref="org.sakaiproject.user.api.UserDirectoryService" />
    </bean>

</beans>
