
<!-- lti_tool_site.vm -->

${includeLatestJQuery}

<script>includeWebjarLibrary('datatables');</script>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		const table = document.getElementById('tools_site');
		if (!table) return;

		const headers = Array.from(table.tHead.rows[0].cells);
		const sortedColumn = headers.findIndex(header => header.id === '$!LAST_SORTED_FIELD');
		const start = $sortIndex - 1;
		const pageLength = $sortPageSize;
		const direction = #if ($ASCENDING_ORDER) 'asc' #else 'desc' #end;

		new DataTable(table, {
			titleRow: 0,
			serverSide: true,
			deferLoading: $count_contents,
			displayStart: start,
			pageLength,
			lengthMenu: [10, 50, 100, 200],
			searching: false,
			language: { emptyTable: table.dataset.emptyMessage },
			orderMulti: false,
			order: sortedColumn < 0 ? [] : [[sortedColumn, direction]],
			columnDefs: [{ targets: 'no-sort', orderable: false, searchable: false }],
			layout: { bottomEnd: { paging: { type: 'full' } } },
			// Keep database paging and sorting through the existing tool actions.
			ajax: function(request) {
				if (request.length !== pageLength) {
					window.location.href = '#toolLinkParam("ToolSite" "doChangePageSize" "pagesize=#pageSize#")'
						.replace(/&amp;/g, '&').replace('#pageSize#', request.length);
				} else if (request.order.length && (request.order[0].column !== sortedColumn || request.order[0].dir !== direction)) {
					window.location.href = '#toolLinkParam("ToolSite" "doSort" "criteria=#criteria#")'
						.replace(/&amp;/g, '&').replace('#criteria#', headers[request.order[0].column].id);
				} else if (request.start !== start) {
					const pageEvent = request.start === 0 ? 'first'
						: request.start > start ? (request.start === start + pageLength ? 'next' : 'last') : 'prev';
					window.location.href = '#toolLinkParam("ToolSite" "doChangePage" "page_event=#pageEvent#")'
						.replace(/&amp;/g, '&').replace('#pageEvent#', pageEvent);
				}
			},
		});

		//prepare searching fields
		let changeTimeout = null;

		const onInputchange = function(){
			if(changeTimeout != null) {
				clearTimeout(changeTimeout);
			}
			const id = this.id.replace('input_', '');
			const value = this.value;
			changeTimeout = setTimeout(function() { doChange(id, value); }, 1000);
		};

		document.querySelectorAll("#tools_site thead tr td input").forEach(function(input) {
			input.addEventListener("input", onInputchange);
			const id = input.id;
			if(id) {
				const header = document.getElementById(id.replace('input_', ''));
				if (header) {
					const label = header.getAttribute('data-placeholder');
					input.setAttribute('placeholder', label);
					input.setAttribute('aria-label', label);
				}
			}
			input.addEventListener("focus", function() {
				this.value = this.value;
			});
		});

		document.querySelectorAll("#tools_site thead tr td select").forEach(function(select) {
			select.addEventListener("change", onInputchange);
		});

		const doChange = function(id, val) {
			window.location.href = '#toolLinkParam("ToolSite" "doSearch" "field=#fieldId#&search=#searchField#")'
				.replace(/&amp;/g, '&')
				.replace('#fieldId#', id)
				.replace('#searchField#', encodeURIComponent(val));
		};

		#if($!SEARCH_LAST_FIELD)
			document.getElementById("input_$!SEARCH_LAST_FIELD")?.focus();
		#end

	});
</script>

<div class="portletBody">
	<ul class="navIntraTool actionToolBar">
		<li class="firstToolBarItem"><span><a href="" title="$tlang.getString("tool.in.system")" onclick="location = '$sakai_ActionURL.setPanel("ToolSystem")';return false;"> $tlang.getString("tool.in.system")</a></span></li>
		<li><span class="current">$tlang.getString("tool.in.site")</span></li>
	</ul>
	#if ($messageSuccess)<div class="sak-banner-success">$tlang.getString("gen.success") $formattedText.escapeHtml($messageSuccess)</div>#end
	#if ($alertMessage)<div class="sak-banner-error">$tlang.getString("gen.alert") $formattedText.escapeHtml($alertMessage)</div>#end
	#if ($isAdmin || $allowMaintainerAddToolSite)
	<div align="right"><a href="" title="$tlang.getString("add.to.site")" class="btn btn-primary" onclick="location = '$sakai_ActionURL.setPanel("ContentPut")';return false;"> $tlang.getString("add.to.site")</a></div>
	<br/>
	$tlang.getString("tool.description.sites")
        #else
	<br/>
	$tlang.getString("tool.description.sites.helper")
	#end
	#if ($hasContents)	
		#if ($contents && $contents.size() > 0)
		<div class="navPanel">
			<div class="listNav">
				<a style="float:right" href="$export_url_excel"><input type="submit" value="$tlang.getString("content.export.excel")" /></a>
				<a class="me-1" style="float:right" href="$export_url_csv"><input type="submit" value="$tlang.getString("content.export.csv")" /></a>
			</div>
		</div>

		#end
		<table data-empty-message="$formattedText.escapeHtml($tlang.getString('content.none'))" id="tools_site" class="table table-striped table-hover" cellspacing="0" summary ="$tlang.getString("content.table")">
			<thead>
			<tr>
				<th id="title" data-placeholder="$tlang.getFormattedMessage('searchby', $tlang.getString('bl_title'))">$tlang.getString("bl_title")</th>
				<th id="searchURL">$tlang.getString("bl_url")
					<input type="hidden" id="URL" data-placeholder="$tlang.getFormattedMessage('searchby', $tlang.getString('bl_url'))" />
				</th>
				#if ($isAdmin) 
					<th id="SITE_TITLE" data-placeholder="$tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitetitle'))">$tlang.getString("bl_sitetitle")</th>
				#end
					<th id="created_at" data-placeholder="$tlang.getFormattedMessage('searchby', $tlang.getString('bl_created_at'))">$tlang.getString("bl_created_at")</th>
				#if ($isAdmin)
					<th id="SITE_CONTACT_NAME" data-placeholder="$tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitecontactname'))">$tlang.getString("bl_sitecontactname")</th>
					<th id="SITE_CONTACT_EMAIL" data-placeholder="$tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitecontactemail'))">$tlang.getString("bl_sitecontactemail")</th>
					#if ($attribution_name)
					<th id="ATTRIBUTION" data-placeholder="$tlang.getFormattedMessage('searchby', $attribution_name)">$attribution_name</th>
					#end
				#end
				<th id="action" width="25%" class="no-sort">$tlang.getString("bl_action")</th>
			</tr>
            <tr class="sakai-datatables-filter-row">
                <td><input class="form-control form-control-sm" id="input_title" #if($search_map && $search_map.get('title')) value="$search_map.get('title')" #end /></td>
                <td><input class="form-control form-control-sm" id="input_URL" #if($search_map && $search_map.get('URL')) value="$search_map.get('URL')" #end /></td>
                #if ($isAdmin)
                    <td><input class="form-control form-control-sm" id="input_SITE_TITLE" #if($search_map && $search_map.get('SITE_TITLE')) value="$search_map.get('SITE_TITLE')" #end /></td>
                #end
                    <td><input class="form-control form-control-sm" id="input_created_at" #if($search_map && $search_map.get('created_at')) value="$search_map.get('created_at')" #end /></td>
                #if ($isAdmin)
                    <td><input class="form-control form-control-sm" id="input_SITE_CONTACT_NAME" #if($search_map && $search_map.get('SITE_CONTACT_NAME')) value="$search_map.get('SITE_CONTACT_NAME')" #end /></td>
                    <td><input class="form-control form-control-sm" id="input_SITE_CONTACT_EMAIL" #if($search_map && $search_map.get('SITE_CONTACT_EMAIL')) value="$search_map.get('SITE_CONTACT_EMAIL')" #end /></td>
                    #if ($attribution_name)
                    <td><input class="form-control form-control-sm" id="input_ATTRIBUTION" #if($search_map && $search_map.get('ATTRIBUTION')) value="$search_map.get('ATTRIBUTION')" #end /></td>
                    #end
                #end
                <td></td>
            </tr>
			</thead>
			<tbody>
			#if ($contents && $contents.size() > 0)
			#foreach ($contentBean in $contents)
			<tr>
			<td headers="title">$formattedText.escapeHtml($contentBean.title)</td>
			<td headers="searchURL">
				#set($launch = "-")
				#if ($contentBean.launch)
					 #set($launch = $formattedText.escapeHtml($contentBean.launch))
				#else
					#set($tool=false)
					#set($tool=$ltiService.getTool($contentBean.toolId, $contentBean.siteId))
					#if ($!tool)
						#set($launch = $formattedText.escapeHtml($tool.get("launch")))
					#end
				#end
				#set($toolUrl = $toolUrlMap.get($contentBean.id))
				<a target="_blank" href="$toolUrl">$launch</a>
			</td>
			#if ($isAdmin) 
				#set($siteUrl = $siteUrlMap.get($contentBean.id))
				<td headers="SITE_TITLE"><a target="_blank" href="$!siteUrl">$formattedText.escapeHtml($!contentBean.siteTitle)</a></td>
			#end
				#set($formattedDate = $formattedDateMap.get($contentBean.id))
				<td headers="created_at">$!formattedDate</td>
			#if ($isAdmin)
				<td headers="SITE_CONTACT_NAME"> $formattedText.escapeHtml($!contentBean.siteContactName)</td>
				<td headers="SITE_CONTACT_EMAIL"> $formattedText.escapeHtml($!contentBean.siteContactEmail)</td>
				#if ($attribution_name)
				<td headers="ATTRIBUTION"> $formattedText.escapeHtml($!contentBean.attribution)</td>
				#end
			#end
			<td headers="action">
            <ul style="list-style: none;">
			<li style="display:inline"><a href="$sakai_ActionURL.setPanel("ContentPut")&id=$contentBean.id">$tlang.getString("gen.edit")</a></li>
			<li style="display:inline"><span aria-hidden="true"> / </span> <a href="$sakai_ActionURL.setPanel("ContentDelete")&id=$contentBean.id">$tlang.getString("gen.delete")</a></li>
            </ul>
			</td>
			</tr>
			#end
			#end
			</tbody>
		</table>
	#else
		<p>$tlang.getString("content.none")</p>
	#end
	$tlang.getString("content.note")
	#if ( $isAdmin ) 
		$tlang.getString("content.admin.note")
	#end
#if ( ! $isAdmin ) 
<script>
document.addEventListener('DOMContentLoaded', function() {
	## Does nothing if we are not in a frame of the right name
	setMainFrameHeight('sakai-lti-admin-iframe'); 
	window.addEventListener('resize', function() {
		setMainFrameHeight('sakai-lti-admin-iframe');
	});
});
</script>
#end
</div>
