<!-- lti_tool_site.vm -->
<script>includeWebjarLibrary('datatables');</script>
<script type="module">
    import { initializeToolLinks } from "/lti-admin-tool/js/tool-links.js";
    initializeToolLinks(document.getElementById("tools_site"), #datatablesBundle($tlang));
</script>

<div class="portletBody">
	<ul class="navIntraTool actionToolBar">
		<li class="firstToolBarItem"><span><a href="" title="$tlang.getString("tool.in.system")" onclick="location = '$sakai_ActionURL.setPanel("ToolSystem")';return false;"> $tlang.getString("tool.in.system")</a></span></li>
		<li><span class="current">$tlang.getString("tool.in.site")</span></li>
	</ul>
	#if ($messageSuccess)<div class="sak-banner-success">$tlang.getString("gen.success") $formattedText.escapeHtml($messageSuccess)</div>#end
	#if ($alertMessage)<div class="sak-banner-error">$tlang.getString("gen.alert") $formattedText.escapeHtml($alertMessage)</div>#end
	#if ($isAdmin || $allowMaintainerAddToolSite)
	<div align="right"><a href="" title="$tlang.getString("add.to.site")" class="btn btn-primary" onclick="location = '$sakai_ActionURL.setPanel("ContentPut")';return false;"> $tlang.getString("add.to.site")</a></div>
	<br/>
	$tlang.getString("tool.description.sites")
        #else
	<br/>
	$tlang.getString("tool.description.sites.helper")
	#end
	<div class="navPanel">
		<div class="listNav">
			<a class="btn btn-secondary" href="$export_url_excel">$tlang.getString("content.export.excel")</a>
			<a class="btn btn-secondary" href="$export_url_csv">$tlang.getString("content.export.csv")</a>
		</div>
	</div>
	<table id="tools_site" class="table table-striped table-hover"
		data-ajax-url="$formattedText.escapeHtml($toolLinksUrl)"
		data-edit-url="$formattedText.escapeHtml($sakai_ActionURL.setPanel('ContentPut'))"
		data-delete-url="$formattedText.escapeHtml($sakai_ActionURL.setPanel('ContentDelete'))"
		data-edit-label="$formattedText.escapeHtml($tlang.getString('gen.edit'))"
		data-delete-label="$formattedText.escapeHtml($tlang.getString('gen.delete'))"
		summary="$tlang.getString('content.table')">
		<thead>
		<tr>
			<th data-field="title" data-column="title">$tlang.getString('bl_title')</th>
			<th data-field="launch" data-column="searchURL">$tlang.getString('bl_url')</th>
			#if ($isAdmin)
			<th data-field="siteTitle" data-column="SITE_TITLE">$tlang.getString('bl_sitetitle')</th>
			#end
			<th data-field="createdAt" data-column="created_at">$tlang.getString('bl_created_at')</th>
			#if ($isAdmin)
			<th data-field="siteContactName" data-column="SITE_CONTACT_NAME">$tlang.getString('bl_sitecontactname')</th>
			#end
			#if ($isAdmin)
			<th data-field="siteContactEmail" data-column="SITE_CONTACT_EMAIL">$tlang.getString('bl_sitecontactemail')</th>
			#end
			#if ($isAdmin && $attribution_name)
			<th data-field="attribution" data-column="ATTRIBUTION">$attribution_name</th>
			#end
			<th data-field="actions">$tlang.getString("bl_action")</th>
		</tr>
		<tr class="sakai-datatables-filter-row">
			<td><input class="form-control form-control-sm" data-column="title" placeholder="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_title')))" aria-label="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_title')))" /></td>
			<td><input class="form-control form-control-sm" data-column="searchURL" placeholder="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_url')))" aria-label="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_url')))" /></td>
			#if ($isAdmin)
			<td><input class="form-control form-control-sm" data-column="SITE_TITLE" placeholder="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitetitle')))" aria-label="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitetitle')))" /></td>
			#end
			<td><input class="form-control form-control-sm" data-column="created_at" placeholder="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_created_at')))" aria-label="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_created_at')))" /></td>
			#if ($isAdmin)
			<td><input class="form-control form-control-sm" data-column="SITE_CONTACT_NAME" placeholder="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitecontactname')))" aria-label="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitecontactname')))" /></td>
			#end
			#if ($isAdmin)
			<td><input class="form-control form-control-sm" data-column="SITE_CONTACT_EMAIL" placeholder="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitecontactemail')))" aria-label="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $tlang.getString('bl_sitecontactemail')))" /></td>
			#end
			#if ($isAdmin && $attribution_name)
			<td><input class="form-control form-control-sm" data-column="ATTRIBUTION" placeholder="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $attribution_name))" aria-label="$formattedText.escapeHtml($tlang.getFormattedMessage('searchby', $attribution_name))" /></td>
			#end
			<td></td>
		</tr>
		</thead>
		<tbody></tbody>
	</table>
	$tlang.getString("content.note")
	#if ($isAdmin)
		$tlang.getString("content.admin.note")
	#end
#if (!$isAdmin)
<script>
document.addEventListener('DOMContentLoaded', function() {
    setMainFrameHeight('sakai-lti-admin-iframe');
    window.addEventListener('resize', function() {
        setMainFrameHeight('sakai-lti-admin-iframe');
    });
});
</script>
#end
</div>
