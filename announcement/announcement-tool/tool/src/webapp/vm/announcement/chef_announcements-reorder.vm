<div class="portletBody container-fluid sakai-reorder">
	#if($menu && $EnabledMenuItemExists)
			#toolbar($menu)
	#end

	#set ($SiteColumnFlag = 0)
	#foreach ($item in $showMessagesList2)
		#set ($ref = $entityManager.newReference($item.Reference))
		#set ($origChannelRef = $service.channelReference($ref.Context,$ref.Container))
		#if (!$origChannelRef.equals($channel.Reference))
			#set ($SiteColumnFlag = $SiteColumnFlag + 1)
		#end
	#end

	<div class="page-header">
		<h1>$tlang.getString("reorder.title")</h1>
	</div>

	#if ($alertMessage)<div class="sak-banner-error">$tlang.getFormattedMessage("gen.alert.message", $alertMessage)</div>#end

	<div class="instruction">
		$tlang.getString('reorder.instruction.general')
		<span id="inputKbdMessage" class="visually-hidden">$tlang.getString('reorder.instruction.general.hidden')</span>
	</div>

	#if ($messageListVector.iterator().hasNext())
		<div class="sakai-reorder-undo noPrint">
			<button type="button" class="btn btn-transparent btn-sm" id="undo-last" disabled>
				<span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span>
				$tlang.getString('reorder.undo.last.label')
			</button>
			<button type="button" class="btn btn-transparent btn-sm" id="undo-all" disabled>
				<span class="bi bi-arrow-repeat" aria-hidden="true"></span>
				$tlang.getString('reorder.undo.all.label')
			</button>
		</div>
		<span id="lastMoveArray" class="d-none"></span>
		<span id="lastMoveArrayInit" class="d-none"></span>
		<span id="lastItemMoved" class="visually-hidden" aria-live="polite" aria-atomic="true" data-moved-message="$tlang.getString('reorder.moved')"></span>
		<form name="announcementListForm" action="#toolForm("AnnouncementAction")" method="post">
			<div id="reorder-list-sortingToolBar" class="sakai-reorder-list-header">
					#if (!$currentSortedBy.equals("subject"))
						<a href="#" class="title" onclick="location='#toolLink("AnnouncementAction" "doSortbysubject")';return false;" title="$tlang.getString('gen.sortby')">$tlang.getString('gen.sortby')</a>
					#else
						#if ($currentSortAsc.equals("true"))
							<a href="#" class="title" onclick="location='#toolLink("AnnouncementAction" "doSortbysubject")';return false;" title="$tlang.getString('gen.sortbyasc')">$tlang.getString('gen.sortby') <span class="bi bi-sort-up" aria-hidden="true"></span></a>
						#else
							<a href="#" class="title" onclick="location='#toolLink("AnnouncementAction" "doSortbysubject")';return false;" title="$tlang.getString('gen.sortbydesc')">$tlang.getString('gen.sortby') <span class="bi bi-sort-down" aria-hidden="true"></span></a>
						#end
					#end
					#if (!$currentSortedBy.equals("from"))
						<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyfrom")';return false;" title="$tlang.getString('gen.sortbyauth')">$tlang.getString('gen.sortbyauth')</a>
					#else
						#if ($currentSortAsc.equals("true"))
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyfrom")';return false;" title="$tlang.getString('gen.sortbyauthasc')">$tlang.getString('gen.sortbyauth') <span class="bi bi-sort-up" aria-hidden="true"></span></a>
						#else
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyfrom")';return false;" title="$tlang.getString('gen.sortbyauthdesc')">$tlang.getString('gen.sortbyauth') <span class="bi bi-sort-down" aria-hidden="true"></span></a>
						#end
					#end
					#if (!$currentSortedBy.equals("releasedate"))
						<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyreleasedate")';return false;" title="$tlang.getString('gen.sortbyreleasedate')">$tlang.getString('gen.sortbyreleasedate')</a>
					#else
						#if ($currentSortAsc.equals("true"))
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyreleasedate")';return false;" title="$tlang.getString('gen.sortbyreleasedateasc')">$tlang.getString('gen.sortbyreleasedate') <span class="bi bi-sort-up" aria-hidden="true"></span></a>
						#else
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyreleasedate")';return false;" title="$tlang.getString('gen.sortbyreleasedatedesc')">$tlang.getString('gen.sortbyreleasedate') <span class="bi bi-sort-down" aria-hidden="true"></span></a>
						#end
					#end
					#if (!$currentSortedBy.equals("retractdate"))
						<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyretractdate")';return false;" title="$tlang.getString('gen.sortbyretractdate')">$tlang.getString('gen.sortbyretractdate')</a>
					#else
						#if ($currentSortAsc.equals("true"))
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyretractdate")';return false;" title="$tlang.getString('gen.sortbyretractdateasc')">$tlang.getString('gen.sortbyretractdate') <span class="bi bi-sort-up" aria-hidden="true"></span></a>
						#else
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbyretractdate")';return false;" title="$tlang.getString('gen.sortbyretractdatedesc')">$tlang.getString('gen.sortbyretractdate') <span class="bi bi-sort-down" aria-hidden="true"></span></a>
						#end
					#end
					#if (!$currentSortedBy.equals("date"))
						<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbydate")';return false;" title="$tlang.getString('gen.sortbydate')">$tlang.getString('gen.sortbydate')</a>
					#else
						#if ($currentSortAsc.equals("true"))
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbydate")';return false;" title="$tlang.getString('gen.sortbydateasc')">$tlang.getString('gen.sortbydate') <span class="bi bi-sort-up" aria-hidden="true"></span></a>
						#else
							<a href="#" onclick="location='#toolLink("AnnouncementAction" "doSortbydate")';return false;" title="$tlang.getString('gen.sortbydatedesc')">$tlang.getString('gen.sortbydate') <span class="bi bi-sort-down" aria-hidden="true"></span></a>
						#end
					#end
			</div>
				<sakai-reorderer id="announcements-reorderer" style="display:block" apply-dom>
				<ul id="reorder-list" class="list-group sakai-reorder-list">

				#set($count = 1)
				#set($reorderListSize = $showMessagesList.size())
				#foreach ($ann_item in $showMessagesList)
					#set($ann_item_props=$ann_item.getProperties())
					<li class="list-group-item reorder-element sakai-reorder-row" id="listitem.orderable$count" data-reorderable-id="listitem.orderable$count">
						<div class="sakai-reorder-row-main">
							<div class="sakai-reorder-move-controls">
								<span class="btn btn-icon sakai-reorder-drag-handle drag-handle"
										tabindex="0"
										role="button"
										title="$tlang.getString('reorder.drag.handle')"
										aria-label="$tlang.getString('reorder.drag.handle')">
									<span class="si si-drag-handle" aria-hidden="true"></span>
								</span>
								<button type="button"
										class="btn btn-icon"
										data-action="move-up"
										#if ($count == 1) disabled="disabled" #end
										title="$tlang.getString('reorder.move.up')"
										aria-label="$tlang.getString('reorder.move.up')">
									<span class="bi bi-chevron-up" aria-hidden="true"></span>
								</button>
								<button type="button"
										class="btn btn-icon"
										data-action="move-down"
										#if ($count == $reorderListSize) disabled="disabled" #end
										title="$tlang.getString('reorder.move.down')"
										aria-label="$tlang.getString('reorder.move.down')">
									<span class="bi bi-chevron-down" aria-hidden="true"></span>
								</button>
							</div>

							<div class="sakai-reorder-row-content">
								<div class="sakai-reorder-title-block">
									<div class="sakai-reorder-display">
										<span class="sakai-reorder-title">$formattedText.escapeHtml($validator.limit($ann_item.Header.subject, 45))</span>
									</div>
									<div class="sakai-reorder-meta">
										<span>$formattedText.escapeHtml($ann_item.Header.From.DisplayName)</span>
										#if (!$ann_item_props.isEmpty() && $ann_item_props.getProperty("releaseDate"))
											<span>$tlang.getString('gen.sortbyreleasedate'): $ann_item_props.getTimeProperty("releaseDate").toStringLocalFull()</span>
										#end
										#if (!$ann_item_props.isEmpty() && $ann_item_props.getProperty("retractDate"))
											<span>$tlang.getString('gen.sortbyretractdate'): $ann_item_props.getTimeProperty("retractDate").toStringLocalFull()</span>
										#end
										#if (!$ann_item_props.isEmpty() && $ann_item_props.getProperty("modDate"))
											<span>$tlang.getString('gen.sortbydate'): $ann_item_props.getTimeProperty("modDate").toStringLocalFull()</span>
										#end
									</div>
									<span class="d-none">
										<input type="checkbox" id="check-$count" name="selectedMembers2" checked="checked" value="$ann_item.Reference"/>
									</span>
								</div>
							</div>
						</div>
					</li>
					#set($count = $count + 1)
				#end
				</ul>
				</sakai-reorderer>
		<div class="act">
			<input type="submit" class="active btn btn-primary" name="eventSubmit_doReorderUpdate" value="$tlang.getString("gen.update")" accesskey="s" />
			<input type="submit" class="btn btn-secondary" accesskey="x" name="eventSubmit_doCancel" value="$tlang.getString("gen.cancel")" />
		</div>
		<input type="hidden" name="sakai_csrf_token" value="$sakai_csrf_token" />
	</form>

 #else
		<div class="instruction">
			#if ($!view == "view.public")
				$tlang.getString("gen.therearepublic")
			#elseif ($!view == "view.bygroup")
				$tlang.getString("gen.therearegroup")
			#else
				$tlang.getString("gen.thereare")
			#end
		</div>
#end
</div>

#module("/webcomponents/bundles/sakai-reorderer.js")
#module("/sakai-announcement-tool/js/announcements-reorder.js")
